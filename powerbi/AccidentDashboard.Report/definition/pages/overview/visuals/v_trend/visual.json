{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "v_trend",
  "position": {
    "x": 20,
    "y": 200,
    "z": 0,
    "height": 500,
    "width": 760
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendar"
                    }
                  },
                  "Property": "year"
                }
              },
              "queryRef": "Calendar.year",
              "nativeQueryRef": "year",
              "active": true,
              "displayName": "Year"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Accident"
                    }
                  },
                  "Property": "Accidents"
                }
              },
              "queryRef": "Accident.Accidents",
              "nativeQueryRef": "Accidents"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Accident"
                    }
                  },
                  "Property": "Fatal Accidents"
                }
              },
              "queryRef": "Accident.Fatal Accidents",
              "nativeQueryRef": "Fatal Accidents"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Calendar"
                  }
                },
                "Property": "year"
              }
            },
            "direction": "Ascending"
          }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Accidents and fatal accidents by year (latest year is partial)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}