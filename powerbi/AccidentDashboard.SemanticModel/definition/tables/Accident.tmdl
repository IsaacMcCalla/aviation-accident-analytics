table Accident
	lineageTag: d58ef78a-6ebd-5968-a51c-8a3f9ee825bd

	measure Accidents = DISTINCTCOUNT(Accident[ev_id])
		formatString: #,0
		lineageTag: eb45bfec-8ba9-549a-bae2-a1891d3720c3

	measure 'Fatal Accidents' = CALCULATE(DISTINCTCOUNT(Accident[ev_id]), Accident[is_fatal] = TRUE())
		formatString: #,0
		lineageTag: 048b9a61-75f9-585c-a5d0-e843bb0076aa

	measure 'Fatal %' = DIVIDE([Fatal Accidents], [Accidents])
		formatString: 0.0%
		lineageTag: 02bd0909-cca9-5ec0-a0f9-90360773aea0

	measure Fatalities = CALCULATE(SUM(Accident[event_fatalities]), Accident[is_primary_aircraft] = TRUE())
		formatString: #,0
		lineageTag: 8c50e665-9682-5835-879c-11d7740c4331

	measure 'Aircraft Involved' = COUNTROWS(Accident)
		formatString: #,0
		lineageTag: ae1580ea-e01f-567d-9df6-44f6a84ab588

	measure 'Avg Latitude' = AVERAGE(Accident[latitude])
		formatString: 0.000
		lineageTag: 299880a9-5625-55ce-86d0-2ecde5d95f1d

	measure 'Avg Longitude' = AVERAGE(Accident[longitude])
		formatString: 0.000
		lineageTag: 6ec64397-4ce6-54b1-99b8-a3e8072b5af7

	measure 'Accidents per 1,000 Registered' = IF([Registered Aircraft] >= 100, DIVIDE([Accidents], [Registered Aircraft]) * 1000)
		formatString: 0.0
		lineageTag: 6b81fda4-31ab-54b3-821c-8729fa5d5051

